<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Deck BGA — {{ deck.name }} — Altered Deck</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen">

<div class="max-w-6xl mx-auto px-4 py-8">

    <div class="flex items-center justify-between mb-8">
        <h1 class="text-2xl font-bold text-gray-800">
            <a href="{{ path('admin_dashboard') }}" class="text-indigo-500 hover:text-indigo-700 mr-2">Admin</a>
            <span class="text-gray-400 mx-1">/</span>
            <a href="{{ path('admin_bga_index') }}" class="text-indigo-500 hover:text-indigo-700 mr-2">BGA</a>
            <span class="text-gray-400 mx-1">/</span>
            {{ deck.name }}
        </h1>
        <a href="{{ path('admin_logout') }}" class="text-sm text-gray-400 hover:text-red-500 transition">Déconnexion</a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <div class="space-y-6">

            <div class="bg-white rounded-xl shadow p-6">
                <h2 class="font-semibold text-gray-700 mb-4">Informations</h2>
                <dl class="grid grid-cols-2 gap-3 text-sm">
                    <dt class="text-gray-500">ID</dt>
                    <dd class="font-mono text-xs">{{ deck.id }}</dd>
                    <dt class="text-gray-500">Format</dt>
                    <dd>{{ deck.format }}</dd>
                    <dt class="text-gray-500">Faction</dt>
                    <dd>{{ faction ?? '—' }}</dd>
                    <dt class="text-gray-500">Héros</dt>
                    <dd class="font-mono text-xs">{{ deck.stats.hero.reference ?? '—' }}</dd>
                    <dt class="text-gray-500">Total cartes</dt>
                    <dd>{{ deck.stats.totalCards ?? '—' }}</dd>
                    <dt class="text-gray-500">Statut</dt>
                    <dd>
                        {% if deck.isPublic %}
                            <span class="inline-block px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-700">Public</span>
                        {% else %}
                            <span class="inline-block px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600">Privé</span>
                        {% endif %}
                    </dd>
                </dl>
            </div>

            <div class="bg-white rounded-xl shadow p-6">
                <h2 class="font-semibold text-gray-700 mb-4">Collection JSON</h2>
                <pre class="text-xs bg-gray-50 rounded-lg p-4 overflow-x-auto max-h-96"><code>{{ collectionJson }}</code></pre>
            </div>

            {% if hasErrors %}
                <div class="bg-red-50 border border-red-200 rounded-xl p-6">
                    <h2 class="font-semibold text-red-700 mb-2">Erreurs de format</h2>
                    <ul class="list-disc list-inside text-sm text-red-600 space-y-1">
                        {% for error in formatErrors %}
                            <li>{{ error }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

        </div>

        <div class="bg-white rounded-xl shadow p-6">
            <h2 class="font-semibold text-gray-700 mb-4">Item JSON (normalisé)</h2>
            <pre class="text-xs bg-gray-50 rounded-lg p-4 overflow-x-auto max-h-[70vh]"><code>{{ itemJson }}</code></pre>
        </div>

    </div>

</div>
</body>
</html>
