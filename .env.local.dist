# Copy this file to .env.local before starting development.
# `make install` does it automatically on first run.
# Never commit .env.local — it is gitignored.

# Altered Core API — shared dev instance
ALTERED_CORE_URL=https://cards.alteredcore.org

# Dev auth bypass — keeps Keycloak out of local dev entirely (recommended)
# Set to false only if you explicitly need to test Keycloak integration.
DEV_AUTH_ENABLED=true

# Keycloak — only needed when DEV_AUTH_ENABLED=false (ask a teammate for values)
# KEYCLOAK_BASE_URL=
# KEYCLOAK_REALM=
# KEYCLOAK_CLIENT_ID=
# KEYCLOAK_CLIENT_SECRET=

# Database — not needed for Docker dev (compose.yaml injects it automatically).
# Uncomment only if you run Symfony commands from the host (outside Docker):
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
